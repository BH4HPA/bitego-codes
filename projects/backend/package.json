{
  "name": "bitego-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "node dist/migrate.js",
    "test:inner": "node --test --test-concurrency=1",
    "test": "node scripts/runTestsWithStoreSnapshot.js test",
    "test:coverage:inner": "c8 --reporter=text-summary --reporter=json-summary --report-dir coverage --include \"dist/routes/**\" --include \"dist/middlewares/**\" --include \"dist/http/**\" --include \"dist/qcloud/**\" --exclude \"dist/entities/**\" --exclude \"dist/migrations/**\" --exclude \"dist/db.js\" --exclude \"dist/index.js\" --exclude \"dist/app.js\" --check-coverage --lines 90 --statements 90 --functions 90 node --test --test-concurrency=1",
    "test:coverage": "node scripts/runTestsWithStoreSnapshot.js coverage",
    "test:ci": "yarn lint && yarn test:coverage",
    "check:migrations": "node scripts/checkMigrations.js",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "18.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.9.7",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.20",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.19",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "c8": "9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "yarn@4.13.0"
}
