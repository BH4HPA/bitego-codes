# Copy this file to .env and fill in the blanks before running `docker compose up -d`.
# Secrets are intentionally left blank — get them from the project owner (or use your own).
# Public/config-style values keep the bitego defaults so a fresh clone runs without lookup.

# --- 后端 CORS 允许来源（必填，开发也必须配） ---
# 后端容器在 Dockerfile 里固定 NODE_ENV=production，会走严格 CORS 白名单：
# 任何不在 H5APP_DOMAIN / WEBADMIN_DOMAIN origin 列表里的浏览器请求都会被拒。
# 新人最常踩的坑就是 docker compose up 起来了，admin / H5 一访问就被 CORS 拦下。
# 本地默认对应 web-admin 的 Vite 端口（5173）和 H5 的 Taro 端口（10086）。
# 部署到正式域名时，改成 https://admin.bitego.net/ 和 https://app.bitego.net/。
WEBADMIN_DOMAIN=http://127.0.0.1:5173/
H5APP_DOMAIN=http://127.0.0.1:10086/

# --- TypeORM ---
# 本地开发用 sync，部署到生产前把 SYNC=false、MIGRATIONS_RUN=true。
TYPEORM_SYNC=true
TYPEORM_MIGRATIONS_RUN=false

# --- 腾讯云访问凭证（机密，必填）---
# 控制台：https://console.cloud.tencent.com/cam/capi
QCLOUD_SECRET_ID=
QCLOUD_SECRET_KEY=

# --- 静态资源 COS（图片、商品图等用户上传文件）---
QCLOUD_COS_BUCKET=bitego-static-1251306253
QCLOUD_COS_REGION=ap-shanghai
QCLOUD_COS_ENDPOINT=cos.accelerate.myqcloud.com
QCLOUD_COS_CDN_DOMAIN=https://static.bitego.net/

# --- Web 管理端 静态托管 COS（admin.bitego.net 部署目标）---
QCLOUD_WEBADMIN_COS_BUCKET=bitego-admin-1251306253
QCLOUD_WEBADMIN_COS_REGION=ap-shanghai
QCLOUD_WEBADMIN_COS_ENDPOINT=cos.accelerate.myqcloud.com

# --- 小程序 H5 静态托管 COS（app.bitego.net 部署目标）---
QCLOUD_H5APP_COS_BUCKET=bitego-app-1251306253
QCLOUD_H5APP_COS_REGION=ap-shanghai
QCLOUD_H5APP_COS_ENDPOINT=cos.accelerate.myqcloud.com

# --- Landing 静态托管 COS（bitego.net / www.bitego.net 部署目标）---
QCLOUD_LANDING_COS_BUCKET=bitego-landing-1251306253
QCLOUD_LANDING_COS_REGION=ap-shanghai
QCLOUD_LANDING_COS_ENDPOINT=cos.accelerate.myqcloud.com
LANDING_DOMAIN=https://bitego.net/
LANDING_DOMAIN_WWW=https://www.bitego.net/

# --- 后端镜像仓库（CI 推送用，机密包含 PASSWORD）---
QCLOUD_DOCKER_SERVER=useccr.ccs.tencentyun.com
QCLOUD_DOCKER_USERNAME=
QCLOUD_DOCKER_PASSWORD=
QCLOUD_DOCKER_REPOSITORY=bitego/backend

# --- 后端线上域名（CI 构建 web-admin/H5 时注入 VITE_API_BASE_URL / TARO_APP_API_BASE_URL）---
BACKEND_DOMAIN=https://api.bitego.net/

# --- 微信小程序（机密，必填用于 wechat 登录 / openid 换取）---
# 控制台：https://mp.weixin.qq.com/  → 开发 → 开发管理 → 开发设置
WX_MINIPROGRAM_APPID=
WX_MINIPROGRAM_SECRET=
